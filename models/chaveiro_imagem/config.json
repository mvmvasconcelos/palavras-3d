{
    "id": "chaveiro_imagem",
    "name": "Chaveiro com Imagem e Texto",
    "description": "Crie um chaveiro em formato de retângulo ou círculo, com borda, texto e imagem.",
    "thumbnail": "/static/img/chaveiro_imagem_thumb.png",
    "features": [],
    "parameters": [
        {
            "id": "base_shape",
            "label": "Formato da Base",
            "type": "select",
            "options": [
                {
                    "value": "RECTANGLE",
                    "label": "Retângulo"
                },
                {
                    "value": "CIRCLE",
                    "label": "Círculo"
                }
            ],
            "default": "RECTANGLE"
        },
        {
            "id": "base_length",
            "label": "Comprimento / Diâmetro (mm)",
            "type": "number",
            "min": 20,
            "max": 200,
            "step": 1,
            "default": 60
        },
        {
            "id": "base_width",
            "label": "Largura (Retângulo) (mm)",
            "type": "number",
            "min": 10,
            "max": 200,
            "step": 1,
            "default": 30
        },
        {
            "id": "base_height",
            "label": "Altura da base (mm)",
            "type": "number",
            "min": 1,
            "max": 20,
            "step": 0.5,
            "default": 4
        },
        {
            "id": "text1",
            "label": "Texto",
            "type": "text",
            "maxLength": 50,
            "default": "Meu Chaveiro"
        },
        {
            "id": "svg_file",
            "label": "Arquivo SVG (Opcional)",
            "type": "file",
            "accept": ".svg"
        }
    ],
    "categories": [
        {
            "name": "Borda e Relevo",
            "parameters": [
                {
                    "id": "border_radius",
                    "label": "Arredondamento Puxador (mm)",
                    "type": "range",
                    "min": 0,
                    "max": 15,
                    "step": 1,
                    "default": 3
                },
                {
                    "id": "border_width",
                    "label": "Largura da Borda (mm)",
                    "type": "number",
                    "min": 0,
                    "max": 10,
                    "step": 0.5,
                    "default": 2
                },
                {
                    "id": "border_height",
                    "label": "Altura da Borda/Conteúdo (mm)",
                    "type": "number",
                    "min": 0.5,
                    "max": 10,
                    "step": 0.5,
                    "default": 2
                }
            ]
        },
        {
            "name": "Furo",
            "parameters": [
                {
                    "id": "hole_diameter",
                    "label": "Diâmetro do Furo (mm)",
                    "type": "number",
                    "min": 1,
                    "max": 10,
                    "step": 0.1,
                    "default": 3.2
                },
                {
                    "id": "hole_margin",
                    "label": "Margem do Furo (mm)",
                    "type": "number",
                    "min": 1,
                    "max": 10,
                    "step": 0.5,
                    "default": 4
                }
            ]
        },
        {
            "name": "Posicionamento",
            "parameters": [
                {
                    "id": "content_x",
                    "label": "Posição X Texto/SVG",
                    "type": "number",
                    "min": -100,
                    "max": 100,
                    "step": 1,
                    "default": 0
                },
                {
                    "id": "content_y",
                    "label": "Posição Y Texto/SVG",
                    "type": "number",
                    "min": -100,
                    "max": 100,
                    "step": 1,
                    "default": 0
                },
                {
                    "id": "text_size",
                    "label": "Tamanho do Texto",
                    "type": "number",
                    "min": 5,
                    "max": 100,
                    "step": 1,
                    "default": 10
                },
                {
                    "id": "svg_max_width",
                    "label": "Tamanho Máximo SVG",
                    "type": "number",
                    "min": 5,
                    "max": 150,
                    "step": 1,
                    "default": 20
                }
            ]
        },
        {
            "name": "Cores",
            "parameters": [
                {
                    "id": "base_color",
                    "label": "Cor da Base",
                    "type": "color",
                    "default": "#1B40D1"
                },
                {
                    "id": "letters_color",
                    "label": "Cor da Borda/Conteúdo",
                    "type": "color",
                    "default": "#FFFFFF"
                }
            ]
        }
    ]
}